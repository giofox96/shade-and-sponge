# Secrets (keys live in Windows user environment variables, never in files)
.env
.env.*
*.key
*.pem
.claude/settings.local.json

# Copyrighted papers and text derived from them (Zotero is the source of truth)
papers/
notes/lit/text/
notes/lit/digest/

# Large raw downloads (re-downloaded by scripts) and third-party trait databases
databases/*/arbrat_viari.csv
databases/*/alberi.geojson
databases/TRY_DATABASE/

# Python / OS
__pycache__/
*.pyc
.ipynb_checkpoints/
Thumbs.db
.DS_Store

# Raw downloads per city (open data + Resilience Atlas layers); re-created by scripts
databases/*/raw/

# osmnx HTTP cache
cache/

# Seminar course material (slides, transcripts, NotebookLM exports); only distilled notes are committed
seminars/
.pytest_cache/
.ruff_cache/
